ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required when running as a Windows service (LocalSystem home resolves to
# C:\Windows\System32\config\systemprofile, not the user home). Set this to
# the canonical .finlens path so service and interactive sessions write the
# same files. Interactive sessions can omit it; Path.home() is used as fallback.
# FINLENS_DATA_DIR=C:\Users\riley\.finlens
